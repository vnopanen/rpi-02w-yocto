#!/bin/sh

### BEGIN INIT INFO
# Provides:          grow-data-partition
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Grow the data partition
### END INIT INFO

DEVICE=/dev/mmcblk0
DATA_PARTITION=${DEVICE}p4

case "$1" in
    start)
        # A different boot medium or an image with no trailing space is a
        # normal no-op. Both tools are intentionally allowed to fail so this
        # init job never prevents the system from completing boot.
        if [ -b "$DEVICE" ] && [ -b "$DATA_PARTITION" ]; then
            /usr/sbin/parted --script "$DEVICE" resizepart 4 100% >/dev/null 2>&1 || true
            /sbin/resize2fs "$DATA_PARTITION" >/dev/null 2>&1 || true
        fi
        ;;
    stop|restart|force-reload|status)
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload|status}"
        exit 1
        ;;
esac

exit 0
