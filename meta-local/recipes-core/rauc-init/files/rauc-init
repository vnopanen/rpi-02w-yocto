#!/bin/sh

### BEGIN INIT INFO
# Provides:          rauc
# Required-Start:    $remote_fs $syslog dbus
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: RAUC update service
### END INIT INFO

DAEMON=/usr/bin/rauc
PIDFILE=/run/rauc-service.pid

case "$1" in
    start)
        if [ -x "$DAEMON" ]; then
            start-stop-daemon --start --background --make-pidfile \
                --pidfile "$PIDFILE" --exec "$DAEMON" -- service

            attempts=0
            while [ "$attempts" -lt 30 ]; do
                if grep -q ' /data ' /proc/mounts; then
                    "$DAEMON" status mark-good
                    break
                fi
                attempts=$((attempts + 1))
                sleep 1
            done
        fi
        ;;
    stop)
        start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --exec "$DAEMON" || true
        rm -f "$PIDFILE"
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    status)
        if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            exit 0
        fi
        exit 1
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload|status}"
        exit 1
        ;;
esac

exit 0
